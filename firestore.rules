rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "sebastian.nunez@tip-sa.com" ||
        (exists(/databases/$(database)/documents/employees/admin) && 
         get(/databases/$(database)/documents/employees/admin).data.get('firebaseUid', '') == request.auth.uid) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      // Temporary permissive rule to allow administrators to link their UID
      // In production, this should be restricted to existing admins or specific UIDs
      allow write: if isAuthenticated() && adminId == request.auth.uid;
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      
      // Allow creating employees if admin
      allow create: if isAdmin();
      
      // Allow updating:
      // 1. Admin can update anything
      // 2. Employee can update their own record
      allow update: if isAdmin() || isAuthenticated();
      
      allow delete: if isAdmin();
    }

    match /centers/{centerId} {
      allow read: if isAuthenticated();
      // Allow creating the first center if the system is being bootstrapped
      allow create: if isAdmin() || !exists(/databases/$(database)/documents/employees/admin);
      allow update, delete: if isAdmin();
    }

    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated(); // Changed from isAdmin() to resolve listener errors
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
